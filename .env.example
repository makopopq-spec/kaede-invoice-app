GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=

# 会社情報・振込先(任意)。未設定なら楓Care taxiの情報が既定値として使われる。
# 別会社(姉妹会社など)用に同じアプリを展開する場合は、ここをその会社の情報に
# 置き換えること(lib/config.jsは編集不要)。
# COMPANY_NAME=
# COMPANY_REPRESENTATIVE=
# COMPANY_POSTAL_CODE=
# COMPANY_ADDRESS=
# COMPANY_TEL=
# COMPANY_EMAIL=
# COMPANY_INVOICE_REGISTRATION_NUMBER=
# BANK_NAME=
# BANK_BRANCH_NAME=
# BANK_ACCOUNT_TYPE=
# BANK_ACCOUNT_NUMBER=
# BANK_ACCOUNT_HOLDER=
# DOC_NUMBER_PREFIX=

# ローカル開発でLinux用chromiumが使えない場合のみ設定(通常は自動検出)
# CHROME_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
